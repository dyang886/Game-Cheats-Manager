msgid "New version found: {old_version} ➜ {new_version}"
msgstr "Nova versão disponível: {old_version} ➜ {new_version}"

msgid "Would you like to update now?"
msgstr "Deseja atualizar agora?"

msgid "Update Check Failed"
msgstr "Falha ao verificar atualizações"

msgid "Failed to check for software update. You can navigate to `Options` ➜ `About` to check for updates manually."
msgstr "Falha ao verificar atualizações do aplicativo. Acesse `Opções` ➜ `Sobre` para verificar atualizações manualmente."

msgid "Attention"
msgstr "Atenção"

msgid "Cheat Engine is already being downloaded, please wait for it to finish."
msgstr "O Cheat Engine já está sendo baixado. Aguarde o término do download."

msgid "Cheat Engine Required"
msgstr "Cheat Engine necessário"

msgid ".ct/.cetrainer files can only be launched through Cheat Engine, but no Cheat Engine installation is currently set."
msgstr "Os arquivos .ct/.cetrainer só podem ser iniciados pelo Cheat Engine, mas nenhum caminho de instalação do Cheat Engine foi definido."

msgid "If you already have Cheat Engine installed, select its installation path under '{trainer_management} → Cheat Engine'."
msgstr "Se você já tem o Cheat Engine instalado, selecione o caminho de instalação em '{trainer_management} → Cheat Engine'."

msgid "Otherwise, would you like to download Cheat Engine now?"
msgstr "Caso contrário, deseja baixar o Cheat Engine agora?"

msgid "Yes"
msgstr "Sim"

msgid "No"
msgstr "Não"

msgid "Success"
msgstr "Sucesso"

msgid "Cheat Engine has already been downloaded in GCM, its installation path has been updated."
msgstr "O Cheat Engine já foi baixado pelo GCM e o caminho de instalação foi atualizado."

msgid "Error"
msgstr "Erro"

msgid "Could not find Cheat Engine in the trainer database, please update GCM data and try again."
msgstr "Não foi possível encontrar o Cheat Engine no banco de dados de treinadores. Atualize os dados do GCM e tente novamente."

msgid "Delete trainer"
msgstr "Excluir treinador"

msgid "Are you sure you want to delete "
msgstr "Tem certeza de que deseja excluir "

msgid "Confirm"
msgstr "Confirmar"

msgid "Cancel"
msgstr "Cancelar"

msgid "Trainer is currently in use, please close any programs using the file and try again."
msgstr "O treinador está em uso. Feche os programas que estejam usando o arquivo e tente novamente."

msgid "Failed to delete {trainer_name}:"
msgstr "Falha ao excluir {trainer_name}:"

msgid "Change trainer download path"
msgstr "Alterar pasta de download dos treinadores"

msgid "Please choose a new path."
msgstr "Selecione um novo caminho."

msgid "Failed to change trainer download path."
msgstr "Falha ao alterar o caminho de download dos treinadores."

msgid "Migrating existing trainers..."
msgstr "Migrando treinadores existentes..."

msgid "No path selected."
msgstr "Nenhum caminho selecionado."

